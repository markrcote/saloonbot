# Dockerfile for saloonbot's server.

FROM python:3.13-slim
ARG GIT_SHA
ARG GIT_COMMIT_DATE
ARG GIT_COMMIT_SUBJECT

# Use a non-root user to avoid warnings about
# running pip as root.
RUN adduser --gecos "" --disabled-password appuser
WORKDIR /app
# .version: SHA, commit date, commit subject (one per line; see version_info.py).
RUN printf '%s\n%s\n%s\n' "$GIT_SHA" "$GIT_COMMIT_DATE" "$GIT_COMMIT_SUBJECT" > .version
USER appuser

# Add ~/.local/bin to PATH to avoid Python
# package warnings.
ENV PATH="/home/appuser/.local/bin:$PATH"

RUN pip install -U pip
COPY --chown=appuser:appuser requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY --chown=appuser:appuser . .

CMD ["python", "server.py"]
